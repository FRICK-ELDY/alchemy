# External client — HTTPS (x001a) + Zenoh WAN TLS (x0022).
# Replace example.tld and <VPS_HOST>. Source or export before cargo run.
#
#   set -a && source edge/client.env.example && set +a   # after editing
#   # or PowerShell:
#   $env:AUTH_URL="https://auth.example.tld"

AUTH_URL=https://auth.example.tld
WORLD_URL=https://world.example.tld
ASSETS_URL=https://assets.example.tld

# x0022: ConoHa zenohd TLS (not localhost when demoing WAN)
ZENOH_CONNECT=tls/<VPS_HOST>:7447
# Private CA only (gen-wan-dev-certs.sh). Omit for Let's Encrypt / public CA:
# ZENOH_TLS_ROOT_CA=/path/to/ca-cert.pem

# ROOM_ID=local
# AUTH_USER=alice
# AUTH_PASSWORD=Password1
# ALCHEMY_FORCE_DESKTOP=1
