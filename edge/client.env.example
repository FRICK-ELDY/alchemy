# External client — HTTPS (x001a) + Zenoh WAN (x001b).
# Replace your-domain.com and <VPS_IP>. Source or export before cargo run.
#
#   set -a && source edge/client.env.example && set +a   # after editing
#   # or PowerShell:
#   $env:AUTH_URL="https://auth.your-domain.com"

AUTH_URL=https://auth.your-domain.com
WORLD_URL=https://world.your-domain.com
ASSETS_URL=https://assets.your-domain.com

# x001b: ConoHa zenohd (not localhost when demoing WAN)
ZENOH_CONNECT=tcp/<VPS_IP>:7447

# ROOM_ID=local
# AUTH_USER=alice
# AUTH_PASSWORD=Password1
# ALCHEMY_FORCE_DESKTOP=1
