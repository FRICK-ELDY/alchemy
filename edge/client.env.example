# External client — HTTPS via Cloudflare Tunnel (x001a).
# Replace example.tld with your Zone. Source or export before cargo run.
#
#   set -a && source edge/client.env.example && set +a   # after editing hostnames
#   # or:
#   export AUTH_URL=https://auth.your.tld
#
# Zenoh stays LAN / localhost until x001b (do not put public zenoh here yet).

AUTH_URL=https://auth.example.tld
WORLD_URL=https://world.example.tld
ASSETS_URL=https://assets.example.tld

# Still local / LAN for this slice:
# ZENOH_CONNECT=tcp/127.0.0.1:7447
# ROOM_ID=local
# AUTH_USER=alice
# AUTH_PASSWORD=Password1
# ALCHEMY_FORCE_DESKTOP=1
