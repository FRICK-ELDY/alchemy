# Local notes only — not loaded by cloudflared. Copy to .env if useful; .env is gitignored.
#
# After `cloudflared tunnel create alchemy-home`, place credentials at:
#   edge/cloudflared/credentials.json
# (usually copied from ~/.cloudflared/<TUNNEL_ID>.json)

TUNNEL_NAME=alchemy-home
TUNNEL_ID=<TUNNEL_ID>

AUTH_HOSTNAME=auth.example.tld
WORLD_HOSTNAME=world.example.tld
ASSETS_HOSTNAME=assets.example.tld
