# Copy to .env.prod (gitignored). Used by docker-compose.prod.yml.
# Generate: mix phx.gen.secret
SECRET_KEY_BASE=
AUTH_JWKS_URL=http://host.docker.internal:4002/.well-known/jwks.json
# x003b: S2S to auth-server (token must match auth AUTH_INTERNAL_TOKEN).
AUTH_INTERNAL_URL=http://host.docker.internal:4002
# Generate: openssl rand -hex 32
AUTH_INTERNAL_TOKEN=
# x0066: optional override; defaults mount ./priv/mtls → /var/lib/world/mtls
# MTLS_CA_CERT_PATH=/var/lib/world/mtls/client-ca-cert.pem
# MTLS_CA_KEY_PATH=/var/lib/world/mtls/client-ca-key.pem
