# x0020 — Desktop client handthrough env example
# Copy values into your shell (do not commit real secrets).
#
# Canonical day-to-day stack (matches client / host-server defaults):
#   auth :4002  world :4003  assets :4004  zenohd :7447

AUTH_URL=http://127.0.0.1:4002
WORLD_URL=http://127.0.0.1:4003
ASSETS_URL=http://127.0.0.1:4004
ZENOH_CONNECT=tcp/127.0.0.1:7447
ROOM_ID=local

# Silent login (omit AUTH_USER / ALCHEMY_AUTH_TOKEN for Home-tab UI login)
AUTH_USER=alice
# debug: AUTH_USER alone may fall back to seed password (x001e).
# release: set AUTH_PASSWORD, or use ALCHEMY_AUTH_TOKEN=<access_jwt> instead of user/pass.
AUTH_PASSWORD=Password1
# ALCHEMY_AUTH_TOKEN=

ALCHEMY_FORCE_DESKTOP=1

# XR SceneGpu session (x0052 default): omit ALCHEMY_FORCE_DESKTOP, SteamVR running.
# Expect floor/mesh/boxes + dash/laser/controllers.

# ---------------------------------------------------------------------------
# Optional: point Desktop at hermetic e2e compose (x001f) instead of day-to-day.
# Requires: docker compose -f docker-compose.e2e.yml up -d --build
#
# AUTH_URL=http://127.0.0.1:4102
# WORLD_URL=http://127.0.0.1:4103
# ASSETS_URL=http://127.0.0.1:4104
# ZENOH_CONNECT=tcp/127.0.0.1:7547
# ---------------------------------------------------------------------------
