# Copy to .env.prod (gitignored). Used by docker-compose.prod.yml.
# Host publish defaults to 127.0.0.1 (x0073). LAN: PUBLISH_ADDR=0.0.0.0
# Generate: mix phx.gen.secret
SECRET_KEY_BASE=
AUTH_JWKS_URL=http://host.docker.internal:4002/.well-known/jwks.json
ASSETS_CAS_BACKEND=local
# For R2 (optional):
# ASSETS_CAS_BACKEND=s3
# ASSETS_S3_BUCKET=
# ASSETS_S3_ENDPOINT=
# ASSETS_S3_ACCESS_KEY_ID=
# ASSETS_S3_SECRET_ACCESS_KEY=
