# assets-server — copy to .env (gitignored) when using R2 / S3 CAS (x001c / x001d).
# Docker Compose reads this file when present (see docker-compose.yml).

# local (default) | s3
ASSETS_CAS_BACKEND=local

# --- when ASSETS_CAS_BACKEND=s3 (Cloudflare R2) ---
# ASSETS_S3_BUCKET=alchemy-cas
# ASSETS_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# ASSETS_S3_ACCESS_KEY_ID=
# ASSETS_S3_SECRET_ACCESS_KEY=
# ASSETS_S3_REGION=auto
# ASSETS_S3_PREFIX=cas/
# ASSETS_S3_PRESIGN_TTL_SECONDS=300
