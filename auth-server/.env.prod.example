# Copy to .env.prod (gitignored). Used by docker-compose.prod.yml.
# Required — leave empty until you set a strong secret (do not commit real values).
#
# Host port publish defaults to 127.0.0.1 (x0073). LAN direct access:
#   PUBLISH_ADDR=0.0.0.0 docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
POSTGRES_PASSWORD=
# Generate: mix phx.gen.secret
SECRET_KEY_BASE=
AUTH_FRONTEND_URL=https://auth.example.tld
PHX_HOST=auth.example.tld
# Host path to RS256 private PEM (mounted read-only into the container)
JWT_PRIVATE_KEY_FILE=./secrets/jwt_private.pem
# x003b: shared secret for world → auth internal access API (must match world .env.prod).
# Generate: openssl rand -hex 32
AUTH_INTERNAL_TOKEN=
# Required behind Cloudflare Tunnel (x002e): CIDRs/IPs of the cloudflared peer only.
# Auth prefers CF-Connecting-IP, then X-Forwarded-For, when remote_ip matches these.
# Do NOT trust the whole Docker bridge (compose.prod publishes 127.0.0.1:4002 by
# default; other containers on 172.16.0.0/12 could forge CF-Connecting-IP and poison
# rate limits if you widen PUBLISH_ADDR).
# Discover cloudflared IP: docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' <cloudflared>
# Local cloudflared on host loopback:
TRUSTED_PROXIES=127.0.0.1,::1
